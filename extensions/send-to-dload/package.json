{
  "name": "send-to-dload",
  "version": "0.2.1",
  "private": true,
  "description": "Forward downloads, magnets, and .torrent links to your self-hosted dload server.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev:ff": "web-ext run --source-dir . --firefox nightly --browser-console",
    "dev:cr": "web-ext run --source-dir . --target chromium --browser-console",
    "lint": "web-ext lint --source-dir . --output text --self-hosted --ignore-files scripts/** tests/** node_modules/** dist/** && eslint src/ && vitest run",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "package:firefox": "node scripts/build.mjs firefox",
    "package:chrome": "node scripts/build.mjs chromium"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "vitest": "^4.1.12",
    "web-ext": "^10.8.0"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "brace-expansion": "^5.0.12",
    "js-yaml": "^4.3.2",
    "shell-quote": "^1.12.0"
  },
  "engines": {
    "node": ">=20.20.2"
  }
}