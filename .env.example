# Docker compose configuration
# Copy this file to .env and customize

GITHUB_REPOSITORY=yourusername/dload

# Run the container as this host user/group so the database and downloaded
# files are owned by you instead of root. Find yours with `id -u` and `id -g`.
PUID=1000
PGID=1000

# Trust X-Forwarded-For / X-Real-IP headers for rate limiting and login
# throttling. Set to 1 ONLY when running behind a trusted reverse proxy that
# overwrites these headers. Without this, proxy headers are ignored and the
# direct socket peer address is used, preventing IP-spoofing bypasses.
DLOAD_TRUST_PROXY_HEADERS=0
